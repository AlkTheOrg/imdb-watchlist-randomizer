{
  "name": "imdb-watchlist-randomizer",
  "version": "1.0.0",
  "description": "",
  "keywords": [],
  "license": "ISC",
  "author": "",
  "main": "index.js",
  "scripts": {
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "build:watch": "vite build --watch --mode development",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint src vite.config.mjs",
    "lint:fix": "oxlint --fix src vite.config.mjs",
    "typecheck": "tsc",
    "typecheck:watch": "tsc --watch --preserveWatchOutput",
    "dev": "pnpm typecheck && pnpm build:dev && concurrently --kill-others --names vite,types,chrome \"pnpm build:watch\" \"pnpm typecheck:watch\" \"web-ext run --source-dir dist --target chromium\""
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^10.0.6",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "web-ext": "^10.7.0"
  },
  "packageManager": "pnpm@10.10.0"
}
