{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["chrome", "vite/client"],
    "jsx": "react-jsx",

    "strict": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,

    "noEmit": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
